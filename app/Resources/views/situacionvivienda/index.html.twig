                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Resp.</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_ovc %}<tr>
                                <td>{{item.resp}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        
        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Paredes</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_paredes %}<tr>
                                <td>{{ item.paredes }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Techo</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_techo %}<tr>
                                <td>{{ item.techo }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">¿Está inscrita en el SIVIH?</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Respuesta</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_sivih %}<tr>
                                <td>{{ item.resp }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">¿Cotiza Ley Política Habitacional?</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Respuesta</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_leypoliticahabitacional %}<tr>
                                <td>{{ item.resp }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Enseres</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_enseres %}<tr>
                                <td>{{ item.enseres }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Salubridad</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_salubridad %}<tr>
                                <td>{{ item.salubridad }}</td>
                                <td>{{ item.cantidad }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
                </table>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Insectos</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
