{% embed 'graficos.html.twig' %}

    {% block body %}
    <h2>Estadísticas Situación Vivienda</h2>
    <hr>

    <div class="row">
        <div class="col-lg-8">
            <div class="card card-body bg-light card card-body bg-light-sm">
                <p>Esta información es referente a un total de {{ total }} familias.</p>
            </div>
        </div>
        {# <div class="col-lg-4">
            <a class="btn btn-lg btn-primary btn-block pull-rigth" href="{{ path('resumen_documento_obtener') }}"><i class="fa fa-file-o"></i> Obtener como PDF</a>
            <hr class="little"></hr>
        </div> #}
    </div>
    <div class="row grid">
        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Condiciones del Terreno</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Resp.</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_condicion_terreno %}<tr>
                                <td>{{item.condicion_terreno}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Forma de Tenencia</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tenencia</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_tipo_tenencia %}<tr>
                                <td>{{item.tipo_tenencia}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Tipos de Vivienda</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_tipo_vivienda %}<tr>
                                <td>{{item.tipo_vivienda}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Habitaciones</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_habitaciones %}<tr>
                                <td>{{item.habitaciones}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Cantidad Habitaciones</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Número Habitaciones</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for keys, value in stat_cant_habitaciones %}<tr>
                                <td>Hogares con {{ keys }} habitaciones</td>
                                <td>{{ value }}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">Terreno Propio</div>
                <div class="card-body">
                    <table class="table table-bordered table-striped table-hover table-sm highchart" data-graph-container-before="1" data-graph-type="pie" data-graph-height="380">
                        <thead>
                            <tr>
                                <th>Resp.</th>
                                <th>Cant.</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stat_terreno %}<tr>
                                <td>{{item.resp}}</td>
                                <td>{{item.cantidad}}</td>
                            </tr>{% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-6 col-12">
            <div class="card border-primary">
                <div class="card-header">¿Pertenece Ud a una OVC?</div>
