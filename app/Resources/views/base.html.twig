					<li class="btn-info"><a style="color: #FFF;" href="{{ path('sic_homepage') }}" data-toggle="tooltip" data-placement="bottom" title="Inicio"><i class="fa fa-home fa-lg"></i>  <span class="visible-xs">Inicio</span></a></li>

					<li class="dropdown btn-primary">
