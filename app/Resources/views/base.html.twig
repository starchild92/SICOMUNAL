<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% block title %}Sistema de Información Comunal{% endblock %}</title>
		
		{% block stylesheets %}{% endblock %}

		<link rel="stylesheet" type="text/css" href="{{ asset('css/bootstrap.css') }}">
		{# <link rel="stylesheet" type="text/css" href="{{ asset('css/bootstrap-theme.css') }}"> #}
		{# <link rel="stylesheet" type="text/css" href="{{ asset('css/darkly-bootstrap.css') }}"> #}
		<link rel="stylesheet" type="text/css" href="{{ asset('css/estilos.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/font-awesome.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/ie10-viewport-bug-workaround.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/datepicker.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/jquery-confirm.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('datatables/datatables.min.css') }}"/>

		{# Clases de Semantic UI #}
		<link rel="stylesheet" type="text/css" href="{{ asset('css/semantic.min.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/dropdown.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/transition.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/icon.css') }}">
		<link rel="stylesheet" type="text/css" href="{{ asset('css/step.css') }}">
		<style>
		@font-face {
		    font-family: 'Open Sans';
		    font-weight: 400;
		    font-style: normal;
		    src: url('{{ asset("fonts/Open-Sans-regular.eot")}}');
		    src: url('{{ asset("fonts/Open-Sans-regular.eot?#iefix")}}') format('embedded-opentype'),
		             local('Open Sans'),
		             local('Open-Sans-regular'),
		             url("{{ asset('fonts/Open-Sans-regular.woff2')}}") format('woff2'),
		             url('{{ asset("fonts/Open-Sans-regular.woff")}}') format('woff'),
		             url('{{ asset("fonts/Open-Sans-regular.ttf")}}') format('truetype'),
		             url('{{ asset("fonts/Open-Sans-regular.svg#OpenSans")}}') format('svg');
		}
		@font-face {
		    font-family: 'Open Sans Condensed';
		    font-weight: 300;
		    font-style: normal;
		    src: url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.eot")}}');
		    src: url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.eot?#iefix")}}') format('embedded-opentype'),
		             local('Open Sans Cond Light'),
		             local('Open-Sans-Condensed-300'),
		             url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.woff2")}}') format('woff2'),
		             url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.woff")}}') format('woff'),
		             url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.ttf")}}') format('truetype'),
		             url('{{ asset("fonts/Open-Sans-Condensed-300/Open-Sans-Condensed-300.svg#OpenSansCondensed")}}') format('svg');
		}
		@font-face {
		    font-family: 'Open Sans';
		    font-weight: 400;
		    font-style: italic;
		    src: url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.eot")}}');
		    src: url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.eot?#iefix")}}') format('embedded-opentype'),
		             local('Open Sans Italic'),
		             local('Open-Sans-italic'),
		             url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.woff2")}}') format('woff2'),
		             url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.woff")}}') format('woff'),
		             url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.ttf")}}') format('truetype'),
		             url('{{ asset("fonts/Open-Sans-italic/Open-Sans-italic.svg#OpenSans")}}') format('svg');
		}
		html, body{ font-family: "Open Sans", sans-serif; }
		</style>
		<link rel="icon" type="image/x-icon" href="{{ asset('favicon.png') }}" />
	</head>
	<body>
		<!-- Fixed navbar -->
		<nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
			<div class="container-fluid">
				<a title="Ir al Inicio" class="navbar-brand" href="{{ path('sic_homepage') }}"><img src="{{ asset('images/logo.png') }}" alt="logo" height="30"></a>
				<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div id="navbar" class="collapse navbar-collapse">
					<ul class="navbar-nav ml-auto">

						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Administrar</a>
							<div class="dropdown-menu dropdown-menu-right">
								<a class="dropdown-item" href="{{ path('comites_index') }}"><i class="fa fa-list-alt fa-fw"></i> Comités</a>
								<a class="dropdown-item" href="{{ path('noticia_index') }}"><i class="fa fa-newspaper-o fa-fw"></i> Noticias</a>
								<a class="dropdown-item" href="{{ path('sic_administacion_entidades') }}"><i class="fa fa-home fa-fw"></i> Identificación del Consejo Comunal</a>
								<a class="dropdown-item" href="{{ path('noticia_correo') }}"><i class="fa fa-envelope fa-fw"></i> Correo Comunitario</a>
								<a class="dropdown-item" target="_new" href="{{ path('bitacora_index') }}"><i class="fa fa-compass fa-fw"></i> Bitácora del Sistema</a>
								<a class="dropdown-item" href="{{ path('usuarios_index') }}"><i class="fa fa-users fa-fw"></i> Usuarios del Sistema</a>
								<a class="dropdown-item" target="_new" href="{{ path('sic_administacion_parametros_planilla') }}"><i class="fa fa-cogs fa-fw"></i> Parámetros en Encuestas</a>
							</div>
						</li>

						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Encuestas</a>
							<div class="dropdown-menu dropdown-menu-right">
								<a class="dropdown-item" href="{{ path('planillas_index') }}"><i class="fa fa-file-o fa-fw"></i> Listar Encuestas</a>
								<a class="dropdown-item" href="{{ path('planillas_new') }}"><i class="fa fa-clipboard fa-fw"></i> Nueva Encuesta</a>
								<div class="dropdown-divider"></div>
								<a class="dropdown-item" title="Obtenga todas las planillas en PDF" target="_new" href="{{ path('sic_todas_las_planillas') }}"><i class="fa fa-file-text-o fa-fw"></i> Imprimir todas las Encuestas</a>
							</div>
						</li>

						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Estadísticas</a>
							<div class="dropdown-menu dropdown-menu-right">
								<a class="dropdown-item" href="{{ path('estadisticas_generales_personas') }}"><i class="fa fa-bar-chart fa-fw"></i> Generales</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_personas_jefegrupofamiliar') }}"><i class="fa fa-pie-chart fa-fw"></i> Jefe Grupo Familiar</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_personas') }}"><i class="fa fa-pie-chart fa-fw"></i> Miembros Grupo Familiar</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_situacion_economica') }}"><i class="fa fa-pie-chart fa-fw"></i> Situación Económica</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_situacion_vivenda') }}"><i class="fa fa-pie-chart fa-fw"></i> Situación Vivienda</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_situacion_salud') }}"><i class="fa fa-pie-chart fa-fw"></i> Situación Salud</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_situacion_servicios') }}"><i class="fa fa-pie-chart fa-fw"></i> Situación Servicios</a>
								<a class="dropdown-item" href="{{ path('sic_estadisticas_situacion_participacion_comunitaria') }}"><i class="fa fa-pie-chart fa-fw"></i> Participación Comunitaria</a>
							</div>
						</li>

						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Otros</a>
							<div class="dropdown-menu dropdown-menu-right">
								<h6 class="dropdown-header">Funciones Especiales</h6>
								<a class="dropdown-item" href="{{ path('agenda_comunitaria') }}"><i class="fa fa-bullhorn fa-fw"></i> Agenda Comunitaria</a>
								<div class="dropdown-divider"></div>
								<h6 class="dropdown-header">Documentos</h6>
								<a class="dropdown-item" href="{{ path('sic_documentos_cuaderno_votacion') }}"><i class="fa fa-file-text-o fa-fw"></i> Cuaderno de Votación</a>
								<a class="dropdown-item" href="{{ path('sic_documentos_resumen_censo') }}"><i class="fa fa-file-text-o fa-fw"></i> Resumen del Censo Demográfico</a>
								<a class="dropdown-item" href="{{ path('sic_documentos_registro_electoral') }}"><i class="fa fa-file-text-o fa-fw"></i> Registro Electoral</a>
								<a class="dropdown-item" href="{{ path('sic_documentos_registro_preliminar') }}"><i class="fa fa-file-text-o fa-fw"></i> Registro Preliminar</a>
							</div>
						</li>

						<li class="nav-item">
							<a class="nav-link" href="{{ path('sic_homepage') }}" title="Inicio"><i class="fa fa-home fa-lg"></i></a>
						</li>

						{% if app.user %}
						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown" title="Mi cuenta"><i class="fa fa-user fa-lg"></i></a>
							<div class="dropdown-menu dropdown-menu-right">
								<h6 class="dropdown-header">{{ app.user.primerNombre }} {{ app.user.primerApellido }}</h6>
								<a class="dropdown-item" href="{{ path('usuarios_show', {id: app.user.id}) }}"><i class="fa fa-eye fa-fw"></i> Ver perfil</a>
								<a class="dropdown-item" href="{{ path('usuarios_edit', {id: app.user.id}) }}"><i class="fa fa-edit fa-fw"></i> Editar perfil</a>
								<div class="dropdown-divider"></div>
								<a class="dropdown-item" href="{{ path('ayuda_del_sistema') }}"><i class="fa fa-info-circle fa-fw"></i> Ayuda del Sistema</a>
							</div>
						</li>
						<li class="nav-item">
							<a class="nav-link text-danger" href="/logout" title="Cerrar sesión"><i class="fa fa-power-off fa-lg"></i></a>
						</li>
						{% endif %}

					</ul>
				</div>
			</div>
		</nav>
		
		{% for flashMessage in app.session.flashbag.get('success') %}
			<div class="alert alert-success text-center" id="mensaje-a-esconder" style="cursor: pointer;">
				<a href="#" class="close" {# data-dismiss="alert" aria-label="close" #}>&times;</a>
				<strong>Éxito!</strong> {{ flashMessage }}
			</div>
		{% endfor %}
		{% for flashMessage in app.session.flashbag.get('info') %}
			<div class="alert alert-info text-center" id="mensaje-a-esconder" style="cursor: pointer;">
				<a href="#" class="close" {# data-dismiss="alert" aria-label="close" #}>&times;</a>
				<strong>Enhorabuena!</strong> {{ flashMessage }}
			</div>
		{% endfor %}
		{% for flashMessage in app.session.flashbag.get('warning') %}
			<div class="alert alert-warning text-center" id="mensaje-a-esconder" style="cursor: pointer;">
				<a href="#" class="close" {# data-dismiss="alert" aria-label="close" #}>&times;</a>
				<strong>No puede continuar!</strong> {{ flashMessage }}
			</div>
		{% endfor %}
		{% for flashMessage in app.session.flashbag.get('error') %}
			<div class="alert alert-danger text-center" id="mensaje-a-esconder" style="cursor: pointer;">
				<a href="#" class="close" {# data-dismiss="alert" aria-label="close" #}>&times;</a>
				<strong>Disculpe!</strong> {{ flashMessage }}
			</div>
		{% endfor %}
		{% for flashMessage in app.session.flashbag.get('danger') %}
			<div class="alert alert-danger text-center" id="mensaje-a-esconder" style="cursor: pointer;">
				<a href="#" class="close" {# data-dismiss="alert" aria-label="close" #}>&times;</a>
				<strong>Disculpe!</strong> {{ flashMessage }}
			</div>
		{% endfor %}

		<div class="container-fluid" style="padding-bottom: 10px;">
			<span id="cuerpo">
			{% block body %}{% endblock %}
			</span>
		</div> <!-- /container -->

		<footer class="footer">
			<div class="container-fluid">
				<p class="text-muted text-center negritas" style="margin-top: 10px; color: #6d4c41">T.E.G - Sistema de Información Comunal <br><small>Luis Pérez | UC - FACyT</small> | <a href="{{ path('ayuda_del_sistema') }}">Ayuda</a></p>
			</div>
		</footer>

		<script src="{{ asset('js/jquery2.1.4.js') }}"></script>
		<script src="{{ asset('js/bootstrap.js') }}"></script>
		<script src="{{ asset('js/jquery-confirm.js') }}"></script>
		<script src="{{ asset('js/ie10-viewport-bug-workaround.js') }}"></script>
		<script src="{{ asset('js/bootstrap-datepicker.js') }}"></script>
		
		{# JS de Semantic UI #}
		<script src="{{ asset('js/dropdown.js') }}"></script>
		<script src="{{ asset('js/package.js') }}"></script>
		<script src="{{ asset('js/index.js') }}"></script>
		<script src="{{ asset('js/transition.js') }}"></script>
		
		<script>
			$(document).ready(function() {
				$('body').on('click','#mensaje-a-esconder', function(){ $(this).fadeOut('slow'); });
				$('[data-toggle="tooltip"]').tooltip()
			});
		</script>
		{% block javascripts %}{% endblock %}
	</body>
</html>
