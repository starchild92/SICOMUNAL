                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Cant.</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in stat_aguasb %}<tr>
                                    <td>{{item.aguasb}}</td>
                                    <td>{{item.cantidad}}</td>
                                </tr>{% endfor %}
